[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 25,Cursors

[Scheme.Cur]
Arrow.cur
Help.ani
Wait.ani
Cross.ani
IBeam.ani
NO.ani
AppStarting.ani
SizeNS.ani
SizeWE.ani
SizeNWSE.ani
SizeAll.cur
UpArrow.cur
SizeNESW.ani
Hand.ani

[Scheme.Reg]
HKCU,"Control Panel\Cursors","Arrow",,"%25%\Cursors\Arrow.cur"
HKCU,"Control Panel\Cursors","Help",,"%25%\Cursors\Help.ani"
HKCU,"Control Panel\Cursors","Wait",,"%25%\Cursors\Wait.ani"
HKCU,"Control Panel\Cursors","Cross",,"%25%\Cursors\Cross.ani"
HKCU,"Control Panel\Cursors","IBeam",,"%25%\Cursors\IBeam.ani"
HKCU,"Control Panel\Cursors","No",,"%25%\Cursors\NO.ani"
HKCU,"Control Panel\Cursors","AppStarting",,"%25%\Cursors\AppStarting.ani"
HKCU,"Control Panel\Cursors","SizeNS",,"%25%\Cursors\SizeNS.ani"
HKCU,"Control Panel\Cursors","SizeWE",,"%25%\Cursors\SizeWE.ani"
HKCU,"Control Panel\Cursors","SizeNWSE",,"%25%\Cursors\SizeNWSE.ani"
HKCU,"Control Panel\Cursors","SizeAll",,"%25%\Cursors\SizeAll.cur"
HKCU,"Control Panel\Cursors","UpArrow",,"%25%\Cursors\UpArrow.cur"
HKCU,"Control Panel\Cursors","SizeNESW",,"%25%\Cursors\SizeNESW.ani"
HKCU,"Control Panel\Cursors","Hand",,"%25%\Cursors\Hand.ani"
; Set scheme name
HKCU,"Control Panel\Cursors","(Default)",,"Ghost"
HKCU,"Control Panel\Cursors\Schemes","Ghost",,""

[Strings]
SCHEME_NAME        = "Ghost"
