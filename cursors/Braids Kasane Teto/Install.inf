; teto

[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%unavailiable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%"

; -- Common Information

[Scheme.Cur]
select.cur
help.cur
Working_in_bgt.ani
busy.ani
text.cur
unavalib.cur
resizever.cur
resizehor.cur
resizedi2.cur
resizedi.cur
move.cur
link.cur
precise.cur
handwriting.cur
altselect.cur
[Strings]
CUR_DIR       = "Cursors\teto"
SCHEME_NAME   = "teto"
pointer       = "select.cur"
help          = "help.cur"
work          = "Working_in_bgt.ani"
busy          = "busy.ani"
text          = "text.cur"
unavailiable  = "unavalib.cur"
vert          = "resizever.cur"
horz          = "resizehor.cur"
dgn1          = "resizedi2.cur"
dgn2          = "resizedi.cur"
move          = "move.cur"
link          = "link.cur"
cross         = "precise.cur"
hand          = "handwriting.cur"
alternate     = "altselect.cur"
