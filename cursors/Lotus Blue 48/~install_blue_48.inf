[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%loc%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
blue_alt.cur
blue_working_48.ani
blue_busy_48.ani
cross.cur
diag1_48.ani
diag2_48.ani
blue_handwriting.cur
blue_help.cur
horiz_48.ani
blue_link.cur
blue_loc.cur
blue_normal.cur
move_48.ani
blue_person.cur
blue_text.cur
unavailable.cur
vert_48.ani

[Scheme.Txt]
~README.txt

[Strings]
CUR_DIR       = "Cursors\Lotus\Blue"
SCHEME_NAME        = "Lotus Blue 48"
pointer       = "blue_normal.cur"
help          = "blue_help.cur"
work          = "blue_working_48.ani"
busy          = "blue_busy_48.ani"
text          = "blue_text.cur"
unavailable   = "unavailable.cur"
vert          = "vert_48.ani"
horz          = "horiz_48.ani"
dgn1          = "diag1_48.ani"
dgn2          = "diag2_48.ani"
move          = "move_48.ani"
link          = "blue_link.cur"
cross         = "cross.cur"
hand          = "blue_handwriting.cur"
alternate     = "blue_alt.cur"
loc	      = "blue_loc.cur"
person	      = "blue_person.cur"