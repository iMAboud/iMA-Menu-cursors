; Royalty Cursor Set

[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%unavailiable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%"

; -- Common Information

[Scheme.Cur]
Royalty Cursor Normal.cur
Royalty Cursor Help.cur
Royalty Cursor Working.ani
Royalty Cursor Busy.ani
Royalty Cursor I Text.cur
Royalty Cursor No.cur
Royalty Cursor Vertical.cur
Royalty Cursor horizontal.cur
Royalty Cursor resize 1.cur
Royalty Cursor resize 2.cur
Royalty Cursor Move.cur
Royalty Cursor Link.cur
Royalty Cursor Precision.cur
Royalty Cursor Pen.cur
Royalty Cursor Alternate.cur
[Strings]
CUR_DIR       = "Cursors\Royalty Cursor Set VSTHEMES ORG"
SCHEME_NAME   = "Royalty Cursor Set VSTHEMES ORG"
pointer       = "Royalty Cursor Normal.cur"
help          = "Royalty Cursor Help.cur"
work          = "Royalty Cursor Working.ani"
busy          = "Royalty Cursor Busy.ani"
text          = "Royalty Cursor I Text.cur"
unavailiable  = "Royalty Cursor No.cur"
vert          = "Royalty Cursor horizontal.cur"
horz          = "Royalty Cursor Vertical.cur"
dgn1          = "Royalty Cursor resize 1.cur"
dgn2          = "Royalty Cursor resize 2.cur"
move          = "Royalty Cursor Move.cur"
link          = "Royalty Cursor Link.cur"
cross         = "Royalty Cursor Precision.cur"
hand          = "Royalty Cursor Pen.cur"
alternate     = "Royalty Cursor Alternate.cur"
