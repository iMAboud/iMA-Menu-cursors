[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg,Wreg


[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"


[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%Unavailiable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%person%,%10%\%CUR_DIR%\%pin%"


[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\Cursors",Crosshair,0x00020000,"%10%\%CUR_DIR%\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\Cursors",No,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\Cursors",Pin,0x00020000,"%10%\%CUR_DIR%\Cursors",Person,0x00020000,"%10%\%CUR_DIR%\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"


[Scheme.Cur]
"Arrow.cur"
"Help.cur"
"Working.ani"
"Busy.ani"
"Cross.cur"
"Text.cur"
"Handwriting.cur"
"Unavailable.cur"
"VResize.cur"
"HResize.cur"
"D1Resize.cur"
"D2Resize.cur"
"Move.cur"
"ArrowUp.cur"
"Link.cur"
"Location.cur"
"Person.cur"


[Strings]
CUR_DIR            = "Cursors\Kuda 30"
SCHEME_NAME        = "Kuda 30"
pointer		= "Arrow.cur"
help		= "Help.cur"
work		= "Working.ani"
busy		= "Busy.ani"
cross		= "Cross.cur"
text		= "Text.cur"
hand		= "Handwriting.cur"
unavailiable	= "Unavailable.cur"
vert		= "VResize.cur"
horz		= "HResize.cur"
dgn1		= "D1Resize.cur"
dgn2		= "D2Resize.cur"
move		= "Move.cur"
alternate	= "ArrowUp.cur"
link		= "Link.cur"
pin		= "Location.cur"
person		= "Person.cur"
