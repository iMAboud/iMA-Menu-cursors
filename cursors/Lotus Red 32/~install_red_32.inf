[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%loc%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
red_alt.cur
red_working_32.ani
red_busy_32.ani
cross.cur
diag1_32.ani
diag2_32.ani
red_handwriting.cur
red_help.cur
horiz_32.ani
red_link.cur
red_loc.cur
red_normal.cur
move_32.ani
red_person.cur
red_text.cur
unavailable.cur
vert_32.ani

[Scheme.Txt]
~README.txt

[Strings]
CUR_DIR       = "Cursors\Lotus\Red"
SCHEME_NAME   = "Lotus Red"
pointer       = "red_normal.cur"
help          = "red_help.cur"
work          = "red_working_32.ani"
busy          = "red_busy_32.ani"
text          = "red_text.cur"
unavailable   = "unavailable.cur"
vert          = "vert_32.ani"
horz          = "horiz_32.ani"
dgn1          = "diag1_32.ani"
dgn2          = "diag2_32.ani"
move          = "move_32.ani"
link          = "red_link.cur"
cross         = "cross.cur"
hand          = "red_handwriting.cur"
alternate     = "red_alt.cur"
loc	      = "red_loc.cur"
person	      = "red_person.cur"