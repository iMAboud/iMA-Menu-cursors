[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%Person%,%10%\%CUR_DIR%\%Pin%"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"

[Scheme.Cur]
"normal_select.ani"
"help_select.ani"
"working_in_background.ani"
"busy.ani"
"precision_select.ani"
"text_select.ani"
"handwriting.ani"
"unavailible.ani"
"vertical_resize.ani"
"horizontal_resize.ani"
"diagonal_resize1.ani"
"diagonal_resize2.ani"
"move.ani"
"alternate_select.ani"
"link_select.ani"
"location_select.ani"
"person_select.ani"

[Strings]
CUR_DIR      		= "Cursors\Neon RGB VSTHEMES ORG"
SCHEME_NAME  		= "Neon RGB VSTHEMES ORG"
pointer				= "normal_select.ani"
help				= "help_select.ani"
work				= "working_in_background.ani"
busy				= "busy.ani"
cross				= "precision_select.ani"
text				= "text_select.ani"
hand				= "handwriting.ani"
unavailable			= "unavailible.ani"
vert				= "vertical_resize.ani"
horz				= "horizontal_resize.ani"
dgn1				= "diagonal_resize1.ani"
dgn2				= "diagonal_resize2.ani"
move				= "move.ani"
alternate			= "alternate_select.ani"
link				= "link_select.ani"
person				= "location_select.ani"
pin					= "person_select.ani"