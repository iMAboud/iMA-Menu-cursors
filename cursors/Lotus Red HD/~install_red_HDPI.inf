[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%loc%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
red_alt.cur
red_working_64.ani
red_busy_64.ani
cross.cur
diag1_64.ani
diag2_64.ani
red_handwriting.cur
red_help.cur
horiz_64.ani
red_link.cur
red_loc.cur
red_normal.cur
move_64.ani
red_person.cur
red_text.cur
unavailable.cur
vert_64.ani

[Scheme.Txt]
~README.txt

[Strings]
CUR_DIR            = "Cursors\Lotus Red HD"
SCHEME_NAME        = "Lotus Red HD"
pointer       = "red_normal.cur"
help          = "red_help.cur"
work          = "red_working_64.ani"
busy          = "red_busy_64.ani"
text          = "red_text.cur"
unavailable   = "unavailable.cur"
vert          = "vert_64.ani"
horz          = "horiz_64.ani"
dgn1          = "diag1_64.ani"
dgn2          = "diag2_64.ani"
move          = "move_64.ani"
link          = "red_link.cur"
cross         = "cross.cur"
hand          = "red_handwriting.cur"
alternate     = "red_alt.cur"
loc	      = "red_loc.cur"
person	      = "red_person.cur"