[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt, Scheme.Cur.Larger, Scheme.Txt.Larger, Scheme.Cur.Largest, Scheme.Txt.Largest, Scheme.Cur.Medium, Scheme.Txt.Medium, Scheme.Cur.Small, Scheme.Txt.Small, Scheme.Cur.Smallest, Scheme.Txt.Smallest, Scheme.Preview, Scheme.QRC
AddReg    = Scheme.Reg, Scheme.Reg.Larger, Scheme.Reg.Largest, Scheme.Reg.Medium, Scheme.Reg.Small, Scheme.Reg.Smallest

; --Destination directories for all necessary folder structure which is mainly read from the [Strings] Section.

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"
Scheme.Cur.Larger = 10,"%CUR_DIR_LARGER%"
Scheme.Cur.Largest = 10,"%CUR_DIR_LARGEST%"
Scheme.Cur.Medium = 10,"%CUR_DIR_MEDIUM%"
Scheme.Cur.Small = 10,"%CUR_DIR_SMALL%"
Scheme.Cur.Smallest = 10,"%CUR_DIR_SMALLEST%"
Scheme.Preview = 10,"Cursors\Polaris v1.0 by Multiple Waters"

; --Registry keys for all the variants of Polaris v1.0 to be written for current user.

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\Polaris v1.0 (Large)\%pointer%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%help%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%work%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%busy%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%cross%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%Text%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%Hand%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%unavailable%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%Vert%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%Horz%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%Dgn1%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%Dgn2%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%move%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%alternate%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%link%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%Person%,%10%\%CUR_DIR%\Polaris v1.0 (Large)\%Pin%"

