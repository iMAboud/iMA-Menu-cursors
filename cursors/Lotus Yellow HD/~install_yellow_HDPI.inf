[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%loc%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
yellow_alt.cur
yellow_working_64.ani
yellow_busy_64.ani
cross.cur
diag1_64.ani
diag2_64.ani
yellow_handwriting.cur
yellow_help.cur
horiz_64.ani
yellow_link.cur
yellow_loc.cur
yellow_normal.cur
move_64.ani
yellow_person.cur
yellow_text.cur
unavailable.cur
vert_64.ani

[Scheme.Txt]
~README.txt

[Strings]
CUR_DIR            = "Cursors\Lotus Yellow HD"
SCHEME_NAME        = "Lotus Yellow HD"
pointer       = "yellow_normal.cur"
help          = "yellow_help.cur"
work          = "yellow_working_64.ani"
busy          = "yellow_busy_64.ani"
text          = "yellow_text.cur"
unavailable   = "unavailable.cur"
vert          = "vert_64.ani"
horz          = "horiz_64.ani"
dgn1          = "diag1_64.ani"
dgn2          = "diag2_64.ani"
move          = "move_64.ani"
link          = "yellow_link.cur"
cross         = "cross.cur"
hand          = "yellow_handwriting.cur"
alternate     = "yellow_alt.cur"
loc	      = "yellow_loc.cur"
person	      = "yellow_person.cur"