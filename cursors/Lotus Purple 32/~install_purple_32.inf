[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%loc%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
purple_alt.cur
purple_working_32.ani
purple_busy_32.ani
cross.cur
diag1_32.ani
diag2_32.ani
purple_handwriting.cur
purple_help.cur
horiz_32.ani
purple_link.cur
purple_loc.cur
purple_normal.cur
move_32.ani
purple_person.cur
purple_text.cur
unavailable.cur
vert_32.ani

[Scheme.Txt]
~README.txt

[Strings]
CUR_DIR       = "Cursors\Lotus\Purple"
SCHEME_NAME   = "Lotus Purple"
pointer       = "purple_normal.cur"
help          = "purple_help.cur"
work          = "purple_working_32.ani"
busy          = "purple_busy_32.ani"
text          = "purple_text.cur"
unavailable   = "unavailable.cur"
vert          = "vert_32.ani"
horz          = "horiz_32.ani"
dgn1          = "diag1_32.ani"
dgn2          = "diag2_32.ani"
move          = "move_32.ani"
link          = "purple_link.cur"
cross         = "cross.cur"
hand          = "purple_handwriting.cur"
alternate     = "purple_alt.cur"
loc	      = "purple_loc.cur"
person	      = "purple_person.cur"