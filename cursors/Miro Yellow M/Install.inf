[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg, Wreg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",0x00020000,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%text%,%10%\%CUR_DIR%\%hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%vert%,%10%\%CUR_DIR%\%horz%,%10%\%CUR_DIR%\%dgn1%,%10%\%CUR_DIR%\%dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%"

[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\%pointer%"
HKCU,"Control Panel\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\%help%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\%work%"
HKCU,"Control Panel\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\%busy%"
HKCU,"Control Panel\Cursors",Crosshair,0x00020000,"%10%\%CUR_DIR%\%cross%"
HKCU,"Control Panel\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\%text%"
HKCU,"Control Panel\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\%hand%"
HKCU,"Control Panel\Cursors",No,0x00020000,"%10%\%CUR_DIR%\%unavailable%"
HKCU,"Control Panel\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\%vert%"
HKCU,"Control Panel\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\%horz%"
HKCU,"Control Panel\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\%dgn1%"
HKCU,"Control Panel\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\%dgn2%"
HKCU,"Control Panel\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\%move%"
HKCU,"Control Panel\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\%alternate%"
HKCU,"Control Panel\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\%link%"
HKCU,"Control Panel\Cursors",Pin,0x00020000,"%10%\%CUR_DIR%\%pin%"
HKCU,"Control Panel\Cursors",Person,0x00020000,"%10%\%CUR_DIR%\%person%"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"

[Scheme.Cur]
"Miro v1.0 (Yellow) Alternate Select (Medium).ani"
"Miro v1.0 (Yellow) Busy (Medium).ani"
"Miro v1.0 (Yellow) Diagonal Resize 1 (Medium).ani"
"Miro v1.0 (Yellow) Diagonal Resize 2 (Medium).ani"
"Miro v1.0 (Yellow) Handwriting (Medium).ani"
"Miro v1.0 (Yellow) Help Select (Medium).ani"
"Miro v1.0 (Yellow) Horizontal Resize (Medium).ani"
"Miro v1.0 (Yellow) Link Select (Medium).ani"
"Miro v1.0 (Yellow) Location Select (Medium).ani"
"Miro v1.0 (Yellow) Move (Medium).ani"
"Miro v1.0 (Yellow) Normal Select (Medium).ani"
"Miro v1.0 (Yellow) Person Select (Medium).ani"
"Miro v1.0 (Yellow) Precision Select (Medium).ani"
"Miro v1.0 (Yellow) Text Select (Medium).ani"
"Miro v1.0 (Yellow) Unavailable (Medium).ani"
"Miro v1.0 (Yellow) Vertical Resize (Medium).ani"
"Miro v1.0 (Yellow) Working In Background (Medium).ani"

[Scheme.Txt]

[Strings]
CUR_DIR            = "Cursors\Miro Yellow M"
SCHEME_NAME        = "Miro Yellow M"
pointer          = "Miro v1.0 (Yellow) Normal Select (Medium).ani"
help             = "Miro v1.0 (Yellow) Help Select (Medium).ani"
work             = "Miro v1.0 (Yellow) Working In Background (Medium).ani"
busy             = "Miro v1.0 (Yellow) Busy (Medium).ani"
cross            = "Miro v1.0 (Yellow) Precision Select (Medium).ani"
text             = "Miro v1.0 (Yellow) Text Select (Medium).ani"
hand             = "Miro v1.0 (Yellow) Handwriting (Medium).ani"
unavailable      = "Miro v1.0 (Yellow) Unavailable (Medium).ani"
vert             = "Miro v1.0 (Yellow) Vertical Resize (Medium).ani"
horz             = "Miro v1.0 (Yellow) Horizontal Resize (Medium).ani"
dgn1             = "Miro v1.0 (Yellow) Diagonal Resize 1 (Medium).ani"
dgn2             = "Miro v1.0 (Yellow) Normal Select (Medium).ani"
move             = "Miro v1.0 (Yellow) Move (Medium).ani"
alternate        = "Miro v1.0 (Yellow) Alternate Select (Medium).ani"
link             = "Miro v1.0 (Yellow) Link Select (Medium).ani"
pin              = "Miro v1.0 (Yellow) Location Select (Medium).ani"
person           = "Miro v1.0 (Yellow) Person Select (Medium).ani"
