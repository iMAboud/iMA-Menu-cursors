[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg,Wreg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%horz%,%10%\%CUR_DIR%\%CUR_DIR%\%dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%person%,%10%\%CUR_DIR%\%pin%"


[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\Cursors",crosshair,0x00020000,"%10%\%CUR_DIR%\Cursors",precisionhair,0x00020000,"%10%\%CUR_DIR%\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\Cursors",No,0x00020000,"%10%\%CUR_DIR%\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"



[Scheme.Cur]
"normal.cur"
"help.ani"
"working.ani"
"busy.ani"
"precision.ani"
"text.cur"
"handwriting.ani"
"unavailable.ani"
"vertical.cur"
"horizontal.cur"
"diagonal1.cur"
"diagonal2.cur"
"move.cur"
"alternate.cur"
"link.ani"

[Strings]
CUR_DIR            = "Cursors\Spiderman"
SCHEME_NAME        = "Spiderman"
pointer		= "normal.cur"
help		= "help.ani"
working		= "working.ani"
busy		= "busy.ani"
precision		= "precision.ani"
text		= "text.cur"
hand		= "handwriting.ani"
unavailable	= "unavailable.ani"
vert		= "vertical.cur"
horz		= "horizontal.cur"
dgn1		= "diagonal1.cur"
dgn2		= "diagonal2.cur"
move		= "move.cur"
alternate	= "alternate.cur"
link		= "link.ani"
