; xFree cursors for Windows XP.
; Win 2000/XP Alphablended Cursor Scheme installation file.

[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailiable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%"

; -- Common Information

[Scheme.Cur]
0.ani
halp!.ani
2.ani
3.ani
txt.ani
unavailable.ani
veres.ani
hores.ani
diag1.ani
diag2.ani
4.ani
lnk.ani
prec.ani
hand.ani
illuminati.cur

[Scheme.Txt]
lol (README).txt

[Strings]
CUR_DIR            = "Cursors\MLP"
SCHEME_NAME        = "MLP"
pointer       = "0.ani"
help          = "halp!.ani"
work          = "2.ani"
busy          = "3.ani"
text          = "txt.ani"
unavailiable  = "unavailable.ani"
vert          = "veres.ani"
horz          = "hores.ani"
dgn1          = "diag1.ani"
dgn2          = "diag2.ani"
move          = "4.ani"
link          = "lnk.ani"
cross         = "prec.ani"
hand          = "hand.ani"
alternate     = "illuminati.cur"