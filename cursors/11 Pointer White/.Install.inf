[Version]
signature="$CHICAGO$"
11Pointer_White
[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg,Wreg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%Unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%person%,%10%\%CUR_DIR%\%pin%"

[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Crosshair,0x00020000,"%10%\%CUR_DIR%\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\Cursors",No,0x00020000,"%10%\%CUR_DIR%\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\Cursors",Person,0x00020000,"%10%\%CUR_DIR%\Cursors",Pin,0x00020000,"%10%\%CUR_DIR%\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"

[Scheme.Cur]
"pointer.cur"
"help.cur"
"work.ani"
"busy.ani"
"cross.cur"       
"text.cur"
"handwriting.cur"
"unavailable.cur"
"vert.cur"
"horz.cur"
"dgn1.cur"
"dgn2.cur"
"move.cur"
"alternate.cur"
"link.cur"
"pin.cur"
"person.cur"
"work_1.ani"
"busy_alternate.ani"
"work_alternate.ani"

[Strings]
CUR_DIR            = "Cursors\11 Pointer White"
SCHEME_NAME        = "11 Pointer White"
pointer		= "pointer.cur"
help		= "help.cur"
work		= "work.ani"
busy		= "busy.ani"
cross		= "cross.cur"
text		= "text.cur"
hand		= "handwriting.cur"
unavailable	= "unavailable.cur"
vert		= "vert.cur"   
horz		= "horz.cur"
dgn1		= "dgn1.cur"
dgn2		= "dgn2.cur"
move		= "move.cur"
alternate	= "alternate.cur"
link		= "link.cur"
person		= "pin.cur"
pin		= "person.cur"

