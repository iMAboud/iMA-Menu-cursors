[Version]
signature="$CHICAGO$"


[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg,Wreg


[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"


[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%Unavailiable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%"


[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Crosshair,0x00020000,"%10%\%CUR_DIR%\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\Cursors",No,0x00020000,"%10%\%CUR_DIR%\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"


[Scheme.Cur]
"Point_arrow.cur"
"Point_help.cur"
"Point_backgrounder.ani"
"Point_busy.ani"
"Point_cross.cur"
"Point_text.cur"
"Point_hand.cur"
"Point_unavailiable.cur"
"Point_portrait.cur"
"Point_transverse.cur"
"Point_top_left_corner.cur"
"Point_lower_right_corner.cur"
"Point_move.cur"
"Point_alternate.cur"
"Point_link.cur"


[Strings]
CUR_DIR            = "Cursors\Round Point"
SCHEME_NAME        = "Round Point"
pointer		= "Point_arrow.cur"
help		= "Point_help.cur"
work		= "Point_backgrounder.ani"
busy		= "Point_busy.ani"
cross		= "Point_cross.cur"
text		= "Point_text.cur"
hand		= "Point_hand.cur"
unavailiable	= "Point_unavailiable.cur"
vert		= "Point_portrait.cur"
horz		= "Point_transverse.cur"
dgn1		= "Point_top_left_corner.cur"
dgn2		= "Point_lower_right_corner.cur"
move		= "Point_move.cur"
alternate	= "Point_alternate.cur"
link		= "Point_link.cur"