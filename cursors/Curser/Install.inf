SCHEME_NAME        = "Curser"
pointer          = "Normal Select.cur"
help             = "Help.ani"
work             = "CMYK Working in Background ver 2.ani"
busy             = "Busy ver 2.ani"
cross            = "Precision.ani"
text             = "Text Select.cur"
