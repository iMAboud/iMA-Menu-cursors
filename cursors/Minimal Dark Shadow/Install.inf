[Version]
signature="$CHICAGO$"
MinimalisticV3DS by Skye084

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg,Wreg


[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"


[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%Unavailiable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%person%,%10%\%CUR_DIR%\%pin%"


[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Crosshair,0x00020000,"%10%\%CUR_DIR%\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\Cursors",No,0x00020000,"%10%\%CUR_DIR%\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\Cursors",Person,0x00020000,"%10%\%CUR_DIR%\Cursors",Pin,0x00020000,"%10%\%CUR_DIR%\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"


[Scheme.Cur]
"AppStarting.ani"
"Arrow.cur"
"Cross.cur"
"Hand.cur"
"Help.cur"
"IBeam.cur"
"NO.cur"
"Pen.cur"
"Person.cur"
"Pin.cur"
"Sall.cur"
"Sdl.cur"
"Sdr.cur"
"Sh.cur"
"Sv.cur"
"UpArrow.cur"
"Wait.ani"


[Strings]
CUR_DIR            = "Cursors\Minimal Dark Shadow"
SCHEME_NAME        = "Minimal Dark Shadow"
work		= "AppStarting.ani"
pointer		= "Arrow.cur"
cross		= "Cross.cur"
link		= "Hand.cur"
help		= "Help.cur"
text		= "IBeam.cur"
unavailiable	= "NO.cur"
hand		= "Pen.cur"
person		= "Person.cur"
pin			= "Pin.cur"
move		= "Sall.cur"
dgn1		= "Sdl.cur"
dgn2		= "Sdr.cur"
vert		= "Sv.cur"
horz		= "Sh.cur"
alternate	= "UpArrow.cur"
busy		= "Wait.ani"