[Version]
signature ="$Chicago$"
[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg = Scheme.Reg
[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"
[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%wait%,%10%\%CUR_DIR%\%CUR_DIR%\%beam%,%10%\%CUR_DIR%\%CUR_DIR%\%no%,%10%\%CUR_DIR%\%CUR_DIR%\%hori%,%10%\%CUR_DIR%\%CUR_DIR%\%dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%CUR_DIR%\%pin%,%10%\%CUR_DIR%\%person%"
[Strings]
CUR_DIR            = "Cursors\Groovy Nord"
SCHEME_NAME        = "Groovy Nord"
arrow		= "arrow.cur"
beam		= "text.cur"
cross		= "cross.cur"
dgn1		= "diag1.cur"
dgn2		= "diag2.cur"
hand		= "hand.cur"
help		= "help.cur"
hori		= "hori.cur"
link		= "link.cur"
move		= "move.cur"
no			= "no.cur"
pen		= "pen.cur"
person	= "person.cur"
pin		= "pin.cur"
start		= "start.ani"
vert		= "vert.cur"
wait		= "wait.ani"
[Scheme.Cur]
start.ani
start1.ani
wait.ani
arrow.cur
cross.cur
diag1.cur
diag2.cur
hand.cur
hand1.cur
help.cur
hori.cur
link.cur
link1.cur
move.cur
move1.cur
no.cur
pen.cur
person.cur
pin.cur
pirate.cur
text.cur
vert.cur
zoom-in.cur
zoom-out.cur
