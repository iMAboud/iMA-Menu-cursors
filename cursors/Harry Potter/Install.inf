[Version]
signature="$CHICAGO$"
Provider="iMA Menu Launcher"

[DefaultInstall]
CopyFiles=Scheme.Cur
AddReg=Scheme.Reg

[DestinationDirs]
Scheme.Cur=10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",0x00020000,"%10%\%CUR_DIR%\%CUR_DIR%\help.cur,%10%\%CUR_DIR%\%CUR_DIR%\busy.cur,%10%\%CUR_DIR%\%CUR_DIR%\ibeam.cur,%10%\%CUR_DIR%\%CUR_DIR%\unavail.cur,%10%\%CUR_DIR%\%CUR_DIR%\horz.cur,%10%\%CUR_DIR%\%CUR_DIR%\dgn2.cur,%10%\%CUR_DIR%\%CUR_DIR%\alternate.cur,%10%\%CUR_DIR%\%CUR_DIR%\pin.cur,%10%\%CUR_DIR%\person.cur"

[Scheme.Cur]
pin.cur
handwriting.cur
unavail.cur
dgn1.cur
link.cur
person.cur
busy.cur
working.cur
vert.cur
dgn2.cur
horz.cur
cross.cur
ibeam.cur
alternate.cur
arrow.cur
move.cur
help.cur

[Strings]
CUR_DIR            = "Cursors\Harry Potter"
SCHEME_NAME        = "Harry Potter"
