[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%loc%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
green_alt.cur
green_working_32.ani
green_busy_32.ani
cross.cur
diag1_32.ani
diag2_32.ani
green_handwriting.cur
green_help.cur
horiz_32.ani
green_link.cur
green_loc.cur
green_normal.cur
move_32.ani
green_person.cur
green_text.cur
unavailable.cur
vert_32.ani

[Scheme.Txt]
~README.txt

[Strings]
CUR_DIR            = "Cursors\Lotus Green 32"
SCHEME_NAME        = "Lotus Green 32"
pointer       = "green_normal.cur"
help          = "green_help.cur"
work          = "green_working_32.ani"
busy          = "green_busy_32.ani"
text          = "green_text.cur"
unavailable   = "unavailable.cur"
vert          = "vert_32.ani"
horz          = "horiz_32.ani"
dgn1          = "diag1_32.ani"
dgn2          = "diag2_32.ani"
move          = "move_32.ani"
link          = "green_link.cur"
cross         = "cross.cur"
hand          = "green_handwriting.cur"
alternate     = "green_alt.cur"
loc	      = "green_loc.cur"
person	      = "green_person.cur"