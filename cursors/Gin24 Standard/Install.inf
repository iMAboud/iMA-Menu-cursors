; GIN'24 Cursors
; ALLAN NYHOLM NIELSEN 2024 for GIN'24 Project
; Thank you MultipleWaters for the help with the Install.inf

[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

; --Destination directories for all necessary folder structure which is mainly read from the [Strings] Section.

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

; --Registry keys for all the variants of GIN'24 to be written for current user.

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%Person%,%10%\%CUR_DIR%\%Pin%"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"

; -- Directory structure of actual cursor files found in the root directory of GIN24

[Scheme.Cur]
NormalSelect.cur
HelpSelect.cur
WorkingInBackground.ani
Busy.ani
TextSelect.cur
Unavailable.cur
VerticalResize.cur
HorizontalResize.cur
DiagonalResize1.cur
DiagonalResize2.cur
Move.cur
LinkSelect.cur
LocationSelect.cur
PersonSelect.cur
PrecisionSelect.cur
Handwriting.cur
AlternateSelect.cur

[Strings]
CUR_DIR = "Cursors\GIN24"
SCHEME_NAME        = "Gin24 Standard"
pointer = "NormalSelect.cur"
help = "HelpSelect.cur"
work = "WorkingInBackground.ani"
busy = "Busy.ani"
text = "TextSelect.cur"
unavailable = "Unavailable.cur"
vert = "VerticalResize.cur"
horz = "HorizontalResize.cur"
dgn1 = "DiagonalResize1.cur"
dgn2 = "DiagonalResize2.cur"
move = "Move.cur"
link = "LinkSelect.cur"
pin = "LocationSelect.cur"
person = "PersonSelect.cur"
cross = "PrecisionSelect.cur"
hand = "Handwriting.cur"
alternate = "AlternateSelect.cur"
