
[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailiable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%"

; -- Common Information

[Scheme.Cur]
normal.ani
ayuda.cur
trabajando.ani
ocupado.ani
texto.ani
no disponible.cur
vertical.ani
horizontal.ani
diagonal1.ani
diagonal2.ani
Mover.ani
link.ani
precision.ani
Alternativo.ani

[Strings]
CUR_DIR            = "Cursors\Kawaii Bear"
SCHEME_NAME        = "Kawaii Bear"
pointer       = "normal.ani"
help          = "ayuda.cur"
work          = "trabajando.ani"
busy          = "ocupado.ani"
text          = "texto.ani"
unavailiable  = "no disponible.cur"
vert          = "vertical.ani"
horz          = "horizontal.ani"
dgn1          = "diagonal1.ani"
dgn2          = "diagonal2.ani"
move          = "Mover.ani"
link          = "link.ani"
cross         = "precision.ani"
alternate     = "alternativo.ani"