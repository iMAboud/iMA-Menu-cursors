[Version]
signature="$Windows NT$"
provider=%INF_Provider%

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg,Wreg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%wait%,%10%\%CUR_DIR%\%CUR_DIR%\%ibeam%,%10%\%CUR_DIR%\%CUR_DIR%\%no%,%10%\%CUR_DIR%\%CUR_DIR%\%sizewe%,%10%\%CUR_DIR%\%CUR_DIR%\%sizenesw%,%10%\%CUR_DIR%\%CUR_DIR%\%uparrow%,%10%\%CUR_DIR%\%CUR_DIR%\%person%,%10%\%CUR_DIR%\%pin%"


[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Crosshair,0x00020000,"%10%\%CUR_DIR%\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\Cursors",No,0x00020000,"%10%\%CUR_DIR%\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\Cursors",Person,0x00020000,"%10%\%CUR_DIR%\Cursors",Pin,0x00020000,"%10%\%CUR_DIR%\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"

[Scheme.Cur]
"arrow.cur"
"help.cur"
"appstarting.ani"
"wait.ani"
"crosshair.cur"
"nwpen.cur"
"no.cur"
"sizens.cur"
"sizewe.cur"
"sizenwse.cur"
"sizenesw.cur"
"sizeall.cur"
"uparrow.cur"
"hand.cur"
"ibeam.cur"
"person.cur"
"pin.cur"


[Strings]
INF_Provider    = "JepriCreations"
CUR_DIR            = "Cursors\Concept 3 Light"
SCHEME_NAME        = "Concept 3 Light"
arrow		    = "arrow.cur"
help		    = "help.cur"
appstarting		= "appstarting.ani"
wait		    = "wait.ani"
crosshair	    = "crosshair.cur"
nwpen		    = "nwpen.cur"
ibeam		    = "ibeam.cur"
no	            = "no.cur"
sizens		    = "sizens.cur"   
sizewe		    = "sizewe.cur"
sizenwse		= "sizenwse.cur"
sizenesw		= "sizenesw.cur"
sizeall		    = "sizeall.cur"
uparrow	        = "uparrow.cur"
hand		    = "hand.cur"
person          = "person.cur"
pin             = "pin.cur"


