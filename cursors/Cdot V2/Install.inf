
[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%location%,%10%\%CUR_DIR%\%person%"

; Installed files

[Scheme.Cur]
"Alternate.cur"
"Cross.cur"
"dgn2.cur"
"Help.cur"
"Link.cur"
"Busy.ani"
"dgn1.cur"
"Handwriting.cur"
"Horz.cur"
"Move.cur"
"Person.cur"
"Pointer.cur"
"Unavailable.cur"
"Work.ani"
"Pin.cur"
"Text.cur"
"Vert.cur"

[Strings]
CUR_DIR            = "Cursors\Cdot V2"
SCHEME_NAME        = "Cdot V2"
pointer = "Pointer.cur"
help = "Help.cur"
work = "Work.ani"
busy = "Busy.ani"
text = "Text.cur"
unavailable = "Unavailable.cur"
vert = "Vert.cur"
horz = "Horz.cur"
dgn1 = "dgn1.cur"
dgn2 = "dgn2.cur"
move = "Move.cur"
link = "Link.cur"
cross = "Cross.cur"
hand = "Handwriting.cur"
alternate = "Alternate.cur"
location = "Pin.cur"
person = "Person.cur"