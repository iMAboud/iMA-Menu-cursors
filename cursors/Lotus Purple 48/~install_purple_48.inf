[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%loc%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
purple_alt.cur
purple_working_48.ani
purple_busy_48.ani
cross.cur
diag1_48.ani
diag2_48.ani
purple_handwriting.cur
purple_help.cur
horiz_48.ani
purple_link.cur
purple_loc.cur
purple_normal.cur
move_48.ani
purple_person.cur
purple_text.cur
unavailable.cur
vert_48.ani

[Scheme.Txt]
~README.txt

[Strings]
CUR_DIR            = "Cursors\Lotus Purple 48"
SCHEME_NAME        = "Lotus Purple 48"
pointer       = "purple_normal.cur"
help          = "purple_help.cur"
work          = "purple_working_48.ani"
busy          = "purple_busy_48.ani"
text          = "purple_text.cur"
unavailable   = "unavailable.cur"
vert          = "vert_48.ani"
horz          = "horiz_48.ani"
dgn1          = "diag1_48.ani"
dgn2          = "diag2_48.ani"
move          = "move_48.ani"
link          = "purple_link.cur"
cross         = "cross.cur"
hand          = "purple_handwriting.cur"
alternate     = "purple_alt.cur"
loc	      = "purple_loc.cur"
person	      = "purple_person.cur"