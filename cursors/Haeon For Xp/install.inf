dgn2				= "Haeon v1.0 Diagonal Resize 2 (Medium).ani"
move				= "Haeon v1.0 Move (Medium).ani"
alternate			= "Haeon v1.0 Alternate Select (Medium).ani"
link				= "Haeon v1.0 Link Select (Medium).ani"
person				= "Haeon v1.0 Location Select (Medium).ani"
pin				= "Haeon v1.0 Person Select (Medium).ani"