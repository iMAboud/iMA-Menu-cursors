[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg
; --Destination directories for all necessary folder structure which is mainly read from the [Strings] Section.

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

; --Registry keys for all the variants of Haeon v1.0 to be written for current user.

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%pointer%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%help%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%work%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%busy%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%cross%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%Text%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%Hand%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%unavailable%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%Vert%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%Horz%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%Dgn1%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%Dgn2%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%move%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%alternate%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%link%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%Person%,%10%\%CUR_DIR%\Haeon v1.0 (Medium)\%Pin%"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"


; -- Directory structure of actual cursor files found in the root directory of Haeon v1.0 by Multiple Waters

[Scheme.Cur]
"\Haeon v1.0 (Medium)\Haeon v1.0 Normal Select (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Help Select (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Working In Background (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Busy (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Precision Select (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Text Select (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Handwriting (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Unavailable (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Vertical Resize (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Horizontal Resize (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Diagonal Resize 1 (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Diagonal Resize 2 (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Move (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Alternate Select (Medium).ani" 
"\Haeon v1.0 (Medium)\Haeon v1.0 Link Select (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Location Select (Medium).ani"
"\Haeon v1.0 (Medium)\Haeon v1.0 Person Select (Medium).ani"

[Strings]
CUR_DIR        			= "Cursors\Haeon v1.0 by Multiple Waters VSTHEMES ORG"
SCHEME_NAME    			= "Haeon v1.0 (Medium) VSTHEMES ORG"
pointer				= "Haeon v1.0 Normal Select (Medium).ani"
help				= "Haeon v1.0 Help Select (Medium).ani"
work				= "Haeon v1.0 Working In Background (Medium).ani"
busy				= "Haeon v1.0 Busy (Medium).ani"
cross				= "Haeon v1.0 Precision Select (Medium).ani"
text				= "Haeon v1.0 Text Select (Medium).ani"
hand				= "Haeon v1.0 Handwriting (Medium).ani"
unavailable			= "Haeon v1.0 Unavailable (Medium).ani"
vert				= "Haeon v1.0 Vertical Resize (Medium).ani"
horz				= "Haeon v1.0 Horizontal Resize (Medium).ani"
