;Kami v2 - Jet Black by BlueGuy on www.deviantart.com/blooguy

[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, 
AddReg    = Scheme.Reg,Wreg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%Unavailiable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%pin%,%10%\%CUR_DIR%\%person%"

; -- Common Information


[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Crosshair,0x00020000,"%10%\%CUR_DIR%\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"


