[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%loc%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
orange_alt.cur
orange_working_32.ani
orange_busy_32.ani
cross.cur
diag1_32.ani
diag2_32.ani
orange_handwriting.cur
orange_help.cur
horiz_32.ani
orange_link.cur
orange_loc.cur
orange_normal.cur
move_32.ani
orange_person.cur
orange_text.cur
unavailable.cur
vert_32.ani

[Scheme.Txt]
~README.txt

[Strings]
CUR_DIR            = "Cursors\Lotus Orange 32"
SCHEME_NAME        = "Lotus Orange 32"
pointer       = "orange_normal.cur"
help          = "orange_help.cur"
work          = "orange_working_32.ani"
busy          = "orange_busy_32.ani"
text          = "orange_text.cur"
unavailable   = "unavailable.cur"
vert          = "vert_32.ani"
horz          = "horiz_32.ani"
dgn1          = "diag1_32.ani"
dgn2          = "diag2_32.ani"
move          = "move_32.ani"
link          = "orange_link.cur"
cross         = "cross.cur"
hand          = "orange_handwriting.cur"
alternate     = "orange_alt.cur"
loc	      = "orange_loc.cur"
person	      = "orange_person.cur"