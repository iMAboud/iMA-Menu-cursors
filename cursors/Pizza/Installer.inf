[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, 
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%Unavailiable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%"

; -- Common Information

[Scheme.Cur]
"food arrow.cur"
"food Helps.cur"
"food working.ani"
"food busy.ani"
"food precision.cur"
"food text.cur"
"food pen.cur"
"food unavail.cur"
"food vertical.cur"
"food horizontal.cur"
"food diagonal 1.cur"
"food diagonal 2.cur"
"food move.cur"
"food up.cur"
"food link.cur"

[Strings]
CUR_DIR            = "Cursors\Pizza"
SCHEME_NAME        = "Pizza"
pointer		= "food arrow.cur"
help		= "food helps.cur"
work		= "food working.ani"
busy		= "food busy.ani"
cross		= "food precision.cur"
text		= "food text.cur"
hand		= "food pen.cur"
unavailiable	= "food unavail.cur"
vert		= "food vertical.cur"
horz		= "food horizontal.cur"
dgn1		= "food diagonal 1.cur"
dgn2		= "food diagonal 2.cur"
move		= "food move.cur"
alternate	= "food up.cur"
link		= "food link.cur"