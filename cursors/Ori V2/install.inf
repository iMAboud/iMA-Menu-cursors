[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%Unavailiable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%"

; -- Common Information

[Scheme.Cur]
"Ori pointer.ani"
"Ori help.ani"
"Ori work.ani"
"Ori Sein busy.ani"
"Ori cross.ani"
"Ori text.cur"
"Ori handw.cur"
"Ori unavailable.ani"
"Ori vert.cur"
"Ori horz.cur"
"Ori dgn 1.cur"
"Ori dgn 2.cur"
"Ori move.cur"
"Ori alternate.cur"
"Ori link.cur"

[Strings]
CUR_DIR            = "Cursors\Ori V2"
SCHEME_NAME        = "Ori V2"
pointer		 = "Ori pointer.ani"
help		 = "Ori help.ani"
work		 = "Ori work.ani"
busy		 = "Ori Sein busy.ani"
cross		 = "Ori cross.ani"
text		 = "Ori text.cur"
hand		 = "Ori handw.cur"
unavailiable = "Ori unavailable.ani"
vert		 = "Ori vert.cur"
horz		 = "Ori horz.cur"
dgn1		 = "Ori dgn 1.cur"
dgn2		 = "Ori dgn 2.cur"
move		 = "Ori move.cur"
alternate	 = "Ori alternate.cur"
link		 = "Ori link.cur"