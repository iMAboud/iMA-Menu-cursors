[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%CUR_DIR%\%Person%,%10%\%CUR_DIR%\%Pin%"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"

[Scheme.Cur]
"normal select.cur"
"help select.ani"
"working in background.ani"
"busy.ani"
"precision select.cur"
"text select.cur"
"handwriting.cur"
"unavailable.cur"
"vertical resize.cur"
"horizontal resize.cur"
"diagonal resize 1.cur"
"diagonal resize 2.cur"
"move.cur"
"alternate select.ani"
"link select.ani"
"location select.cur"
"person select.ani"

[Strings]
CUR_DIR            = "Cursors\Spacecore Red"
SCHEME_NAME        = "Spacecore Red"
pointer				= "normal select.cur"
help				= "help select.ani"
work				= "working in background.ani"
busy				= "busy.ani"
cross				= "precision select.cur"
text				= "text select.cur"
hand				= "handwriting.cur"
unavailable			= "unavailable.cur"
vert				= "vertical resize.cur"
horz				= "horizontal resize.cur"
dgn1				= "diagonal resize 1.cur"
dgn2				= "diagonal resize 2.cur"
move				= "move.cur"
alternate			= "alternate select.ani"
link				= "link select.ani"
person				= "location select.cur"
pin					= "person select.ani"