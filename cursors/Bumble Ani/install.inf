[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt, Scheme.Cur.Larger, Scheme.Txt.Larger, Scheme.Cur.Largest, Scheme.Txt.Largest, Scheme.Cur.Medium, Scheme.Txt.Medium, Scheme.Cur.Small, Scheme.Txt.Small, Scheme.Cur.Smallest, Scheme.Txt.Smallest, Scheme.Preview, Scheme.QRC
AddReg    = Scheme.Reg, Scheme.Reg.Larger, Scheme.Reg.Largest, Scheme.Reg.Medium, Scheme.Reg.Small, Scheme.Reg.Smallest

; --Destination directories for all necessary folder structure which is mainly read from the [Strings] Section.

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"
Scheme.Cur.Larger = 10,"%CUR_DIR_LARGER%"
Scheme.Cur.Largest = 10,"%CUR_DIR_LARGEST%"
Scheme.Cur.Medium = 10,"%CUR_DIR_MEDIUM%"
Scheme.Cur.Small = 10,"%CUR_DIR_SMALL%"
Scheme.Cur.Smallest = 10,"%CUR_DIR_SMALLEST%"
Scheme.Preview = 10,"Cursors\Bumble v1.0 by Multiple Waters"

; --Registry keys for all the variants of Bumble v1.0 to be written for current user.

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%Person%,%10%\%CUR_DIR%\%Pin%"

[Scheme.Reg.Larger]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME_LARGER%",,"%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%pointer_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%help_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%work_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%busy_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%cross_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%Text_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%Hand_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%unavailable_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%Vert_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%Horz_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%Dgn1_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%Dgn2_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%move_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%alternate_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%link_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%Person_Larger%,%10%\%CUR_DIR_Larger%\Bumble v1.0 (Larger)\%Pin_Larger%"

[Scheme.Reg.Largest]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME_LARGEST%",,"%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%pointer_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%help_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%work_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%busy_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%cross_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%Text_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%Hand_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%unavailable_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%Vert_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%Horz_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%Dgn1_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%Dgn2_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%move_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%alternate_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%link_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%Person_Largest%,%10%\%CUR_DIR_Largest%\Bumble v1.0 (Largest)\%Pin_Largest%"

[Scheme.Reg.Medium]
