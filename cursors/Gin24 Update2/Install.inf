[Version]
signature="$CHICAGO$"
ALLAN NYHOLM NIELSEN 2024 for GIN'24 Project

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg,Wreg 

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%CUR_DIR%\%wait%,%10%\%CUR_DIR%\%CUR_DIR%\%beam%,%10%\%CUR_DIR%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%CUR_DIR%\%horz%,%10%\%CUR_DIR%\%CUR_DIR%\%dgnr%,%10%\%CUR_DIR%\%CUR_DIR%\%up%,%10%\%CUR_DIR%\%CUR_DIR%\%person%,%10%\%CUR_DIR%\%pin%"

[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\Cursors",crosshair,0x00020000,"%10%\%CUR_DIR%\Cursors",precisionhair,0x00020000,"%10%\%CUR_DIR%\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\Cursors",No,0x00020000,"%10%\%CUR_DIR%\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\Cursors",Person,0x00020000,"%10%\%CUR_DIR%\Cursors",Pin,0x00020000,"%10%\%CUR_DIR%\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"

[Scheme.Cur]
"arrow.cur"
"help.cur"
"working.ani"
"wait.ani"
"precision.cur"
"pen.cur"
"unavailable.cur"
"vert.cur"
"horz.cur"
"dgnl.cur"
"dgnr.cur"
"move.cur"
"up.cur"
"link.cur"
"beam.cur"
"person.cur"
"pin.cur"

[Strings]
CUR_DIR            = "Cursors\Gin24 Update2"
SCHEME_NAME        = "Gin24 Update2"
arrow		= "arrow.cur"
help		= "help.cur"
working		= "working.ani"
wait		= "wait.ani"
precision	= "precision.cur"
pen		    = "pen.cur"
beam		= "beam.cur"
unavailable	= "unavailable.cur"
vert		= "vert.cur"   
horz		= "horz.cur"
dgnl		= "dgnl.cur"
dgnr		= "dgnr.cur"
move		= "move.cur"
up	        = "up.cur"
link		= "link.cur"
person      = "person.cur"
pin         = "pin.cur"
