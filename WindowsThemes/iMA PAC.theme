; Copyright � iMA

[Theme]
; Windows - IDS_THEME_DISPLAYNAME_iMA - PAC
DisplayName=iMA PAC
SetLogonBackground=0

; Computer - SHIDI_SERVER
[CLSID\{20D04FE0-3AEA-1069-A2D8-08002B30309D}\DefaultIcon]
DefaultValue=%SystemRoot%\System32\imageres.dll,-109

; UsersFiles - SHIDI_USERFILES
[CLSID\{59031A47-3F72-44A7-89C5-5595FE6B30EE}\DefaultIcon]
DefaultValue=%SystemRoot%\System32\imageres.dll,-123

; Network - SHIDI_MYNETWORK
[CLSID\{F02C1A0D-BE21-4350-88B0-7367FC96EF3C}\DefaultIcon]
DefaultValue=%SystemRoot%\System32\imageres.dll,-25

; Recycle Bin - SHIDI_RECYCLERFULL SHIDI_RECYCLER
[CLSID\{645FF040-5081-101B-9F08-00AA002F954E}\DefaultIcon]
Full=%SystemRoot%\System32\imageres.dll,-54
Empty=%SystemRoot%\System32\imageres.dll,-55

[Control Panel\Cursors]
AppStarting=%ResourceDir%\Themes\iMA\Cursors\work.ani
Arrow=%ResourceDir%\Themes\iMA\Cursors\pointer.cur
Crosshair=%ResourceDir%\Themes\iMA\Cursors\cross.cur
Hand=%ResourceDir%\Themes\iMA\Cursors\link.cur
Help=%ResourceDir%\Themes\iMA\Cursors\help.cur
IBeam=%ResourceDir%\Themes\iMA\Cursors\text.cur
No=%ResourceDir%\Themes\iMA\Cursors\unavailable.cur
NWPen=%ResourceDir%\Themes\iMA\Cursors\handwriting.cur
SizeAll=%ResourceDir%\Themes\iMA\Cursors\move.cur
SizeNESW=%ResourceDir%\Themes\iMA\Cursors\dgn2.cur
SizeNS=%ResourceDir%\Themes\iMA\Cursors\vert.cur
SizeNWSE=%ResourceDir%\Themes\iMA\Cursors\dgn1.cur
SizeWE=%ResourceDir%\Themes\iMA\Cursors\horz.cur
UpArrow=%ResourceDir%\Themes\iMA\Cursors\alternate.cur
Wait=%ResourceDir%\Themes\iMA\Cursors\busy.ani
DefaultValue=Windows Default
DefaultValue.MUI=@main.cpl,-1020

[Control Panel\Desktop]
Wallpaper=%SystemRoot%\Resources\Themes\iMA\Wallpapers\1.png
TileWallpaper=0
WallpaperStyle=10
Pattern=

[VisualStyles]
Path=%ResourceDir%\Themes\iMA\PAC.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XFF282C34
SystemMode=Dark
AppMode=Dark

[boot]
SCRNSAVE.EXE=

[MasterThemeSelector]
MTSM=RJSPBS

[Sounds]
; IDS_SCHEME_DEFAULT
SchemeName=@%SystemRoot%\System32\mmres.dll,-800

[Slideshow]
Interval=1800000
Shuffle=0
ImagesRootPath=%SystemRoot%\Resources\Themes\iMA\Wallpapers